# OCR (Google Vision) — required for scanned PDF/image OCR
GOOGLE_VISION_API_KEY=

# Telegram bot (disabled on Vercel; runs with the local OCR service)
TELEGRAM_BOT_TOKEN=

# NVIDIA NIM extraction — primary + fallback keys/models
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_KEY_FALLBACK=
NVIDIA_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY_FALLBACK2=
NVIDIA_MODEL_FALLBACK2=nvidia/nemotron-3-ultra-550b-a55b

# --- Event-driven document processing (Java service) ---
# Kafka broker for Node producer (EXTERNAL listener published by docker-compose)
KAFKA_BROKERS=localhost:9093
# Object storage (S3-compatible) used by /api/ingest + storage.js
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wms-documents
# Where the bots POST ingested documents (fallback target)
INGEST_URL=http://localhost:4001/api/ingest